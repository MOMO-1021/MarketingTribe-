<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MarketingTribe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink</item>
        <item name="colorOnPrimary">@color/bg_paper</item>
        <item name="colorSecondary">@color/accent_terracotta</item>
        <item name="colorSecondaryVariant">@color/accent_terracotta</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/bg_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_paper</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg_paper</item>
    </style>

    <style name="Theme.MarketingTribe.Splash" parent="Theme.MarketingTribe">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
